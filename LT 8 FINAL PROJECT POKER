      "source": "# Cell 4: Evaluator unit testing\ndef check(hole, board, expected_category):\n    rank = HandEvaluator.best_hand(parse_cards(hole), parse_cards(board))\n    assert rank.category == expected_category, (hole, board, rank)\n    return rank\n\n\nroyal = check(\"Ah Kh\", \"Qh Jh Th 2c 3d\", HandCategory.ROYAL_FLUSH)\nsteel_wheel = check(\"Ac 2c\", \"3c 4c 5c Kd Kh\", HandCategory.STRAIGHT_FLUSH)\nquads = check(\"9s 9d\", \"9h 9c Ks 2d 3h\", HandCategory.FOUR_OF_A_KIND)\nboat = check(\"Ks Kd\", \"Kh 7c 7d 2s 3h\", HandCategory.FULL_HOUSE)\nflush = check(\"Ad 3d\", \"Kd 8d 2d Qs Js\", HandCategory.FLUSH)\nwheel = check(\"As 2d\", \"3c 4h 5s Kd Qh\", HandCategory.STRAIGHT)\nsix_high = check(\"6s 2d\", \"3c 4h 5s Kd Qh\", HandCategory.STRAIGHT)\ntrips = check(\"7s 7d\", \"7h Ac Ks 2d 4h\", HandCategory.THREE_OF_A_KIND)\ntwo_pair = check(\"Ks 7d\", \"Kh 7c Ad 2s 3h\", HandCategory.TWO_PAIR)\npair = check(\"Qs Qd\", \"Ah 9c 5d 3s 2h\", HandCategory.ONE_PAIR)\nhigh = check(\"As Jd\", \"9h 7c 5d 3s 2h\", HandCategory.HIGH_CARD)\n\n# Category ordering and special cases.\nladder = [high, pair, two_pair, trips, six_high, flush, boat, quads, steel_wheel, royal]\nassert all(a < b for a, b in zip(ladder, ladder[1:]))\nassert wheel < six_high, \"The wheel (A-5) is the lowest straight.\"\nassert wheel.cards[-1].rank == 14, \"The Ace is displayed last in a wheel.\"\n\n# Best 5 of 7: a 6th straight card upgrades a straight.\nassert check(\"6d 7d\", \"2s 3h 4c 5s Kd\", HandCategory.STRAIGHT).tiebreak == (7,)\n\n# Kicker resolution: same pair, better kicker wins.\nboard = \"Kh 8c 5d 3s 2h\"\nwinners, _ = HandEvaluator.showdown(\n    {\"A\": parse_cards(\"Ks Qd\"), \"B\": parse_cards(\"Kd Jc\")}, parse_cards(board)\n)\nassert winners == [\"A\"], \"Queen kicker beats Jack kicker.\"\n\n# Two pair: the 5th card kicker decides.\nwinners, _ = HandEvaluator.showdown(\n    {\"A\": parse_cards(\"As 4d\"), \"B\": parse_cards(\"Qd 4c\")},\n    parse_cards(\"Kh Kc 9d 9s 2h\"),\n)\nasse