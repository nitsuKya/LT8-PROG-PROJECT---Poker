      "source": "# Cell 8: Stateful heads-up GameEngine (No-Limit or Fixed-Limit)\nclass GameEngine:\n    \"\"\"Runs heads-up Texas Hold'em hands between two players.\n\n    Heads-up rules: the button posts the small blind and acts first\n    pre-flop; the big blind acts first on the flop, turn and river.\n\n    betting=\"no-limit\" (default): players choose their size. The minimum\n    bet is the big blind, a raise must be at least as big as the previous\n    bet or raise on that street, there is no cap on raises, and a player\n    may go all-in at any time. An all-in for less than a full raise is\n    allowed. Any part of a bet the opponent can't match is returned.\n\n    betting=\"limit\": fixed sizes - the small bet (= big blind) pre-flop and\n    on the flop, the big bet (= 2x big blind) on the turn and river, capped\n    at `bet_cap` bets per street (a bet plus three raises).\n\n    `hand_steps()` is a generator that pauses at every decision, which lets\n    a button-driven UI feed in a human's actions. `play_hand()` drives the\n    same generator by asking each seat's agent.\n\n    When a human sits at the table, the bot's hole cards are kept out of\n    every log; they are only shown if the hand reaches showdown.\n    \"\"\"\n\n    BETTING_STRUCTURES = (\"no-limit\", \"limit\")\n\n    def __init__(\n        self,\n        player_one,\n        player_two,\n        small_blind=1,\n        big_blind=2,\n        betting=\"no-limit\",\n        bet_cap=4,\n        seed=None,\n        verbose=True,\n    ):\n        if betting not in self.BETTING_STRUCTURES:\n            raise ValueError(f\"betting must be one of {self.BETTING_STRUCTURES}\")\n        self.betting = betting\n        self.players = [player_one, player_two]\n        self.small_blind = small_blind\n        self.big_blind = big_blind\n        self.small_bet = big_blind\n        self.big_bet = 2 * big_blind\n        self.bet_cap = bet_cap\n        self.rng = random.Random(seed)\n        self.deck = Deck(self.rng)\n        self.verbose = verbose\n        self.button = 0  # index of the player on the button\n        self.hand_number = 0\n        self.street = None\n        self.board = []\n        self.action_log = []\n        self.hand_log = []  # (owner, message) lines for the current hand\n        self.history = []  # one record (dict) per completed hand\n        # With no human seated, it is a spectator simulation: show everything.\n        self.reveal_all = not any(p.agent.interactive for p in self.players)\n\n    # ----- helpers ---------------------------------------------------------\n    def can_see(self, owner):\n        \"\"\"Whether a log line that is private to `owner` may be shown.\"\"\"\n        if owner is None or self.reveal_all:\n            return True\n        return any(p.name == owner and p.agent.interactive for p in self.players)\n\n    def log(self, message, owner=None):\n        \"\"\"Record a log line; `owner` marks it private to that player.\"\"\"\n        self.hand_log.append((owner, message))\n        if self.verbose and self.can_see(owner):\n            print(message)\n\n    @property\n    def pot(self):\n        return sum(player.total_bet for player in self.players)\n\n    def total_chips(self):\n        return sum(player.chips for player in self.players) + self.pot\n\n    def _live_players(self):\n        return [player for player in self.players if not player.folded]\n\n    def _bet_size(self, street):\n        return self.small_bet if street in (\"Pre-Flop\", \"Flop\") else self.big_bet\n\n    # ----- hand flow -------------------------------------------------------\n    def play_hand(self):\n        \"\"\"Play one full hand, asking each seat's agent for its decisions.\"\"\"\n        steps = self.hand_steps()\n        action = None\n        while True:\n            try:\n                player, state = steps.send(action)\n            except StopIteration as finished:\n                return finished.value  # the hand record\n            action = player.agent.decide(state)\n\n    def hand_steps(self):\n        \"\"\"Generator version of a hand.\n\n        Yields (player, TableState) whenever someone must act; resume it with\n        .send(action). When the hand is over it returns the hand record.\n        \"\"\"\n        if any(player.chips == 0 for player in self.players):\n            raise RuntimeError(\"A player is out of chips; the session is over.\")\n        self.hand_number += 1\n        stacks_before = {player.name: player.chips for player in self.players}\n        self.board, self.action_log, self.hand_log = [], [], []\n        for player in self.players:\n            player.reset_for_hand()\n        self.deck.reset()\n        self.deck.shuffle()\n\n        sb_player = self.players[self.button]\n        bb_player = self.players[1 - self.button]\n        self.log(f\"\\n===== Hand #{self.hand_number} | Button: {sb_player.name} =====\")\n        sb_player.commit(self.small_blind)\n        bb_player.commit(self.big_blind)\n        self.log(\n            f\"{sb_player.name} posts SB {self.small_blind}, \"\n            f\"{bb_player.name} posts BB {self.big_blind}\"\n        )\n\n        # Deal one card at a time, starting left of the button.\n        for _ in range(2):\n            for player in (bb_player, sb_player):\n                player.hole_cards += self.deck.deal(1)\n        for player in self.players:\n            self.log(\n                f\"{player.name} is dealt {format_cards(player.hole_cards)}\",\n                owner=player.name,\n            )\n\n        for street in STREETS:\n            self.street = street\n            if street != \"Pre-Flop\":\n                self.deck.burn()\n                self.board += self.deck.deal(BOARD_CARDS_PER_STREET[street])\n                for player in self.players:\n                    player.street_bet = 0\n                self.log(f\"--- {street}: {format_cards(self.board)} (pot {self.pot})\")\n            yield from self._betting_round(street)\n            if len(self._live_players()) == 1:\n                record = self._finish_by_fold()\n                break\n        else:\n            record = self._showdown()\n\n        record[\"net\"] = {p.name: p.chips - stacks_before[p.name] for p in self.players}\n        self.history.append(record)\n        self.button = 1 - self.button\n        return record\n\n    def play_session(self, max_hands=100, reset_stacks=False):\n        \"\"\"Autonomous loop: play until someone busts or max_hands is hit.\n\n        reset_stacks=True restores both starting stacks before every hand,\n        so the session never ends early and results are measured per hand\n        (each record's \"net\"): the usual way to benchmark no-limit bots.\n        \"\"\"\n        start_chips = self.total_chips()\n        starting_stacks = [player.chips for player in self.players]\n        for _ in range(max_hands):\n            if reset_stacks:\n                for player, chips in zip(self.players, starting_stacks):\n                    player.chips = chips\n            elif any(player.chips == 0 for player in self.players):\n                break\n            self.play_hand()\n            assert self.total_chips() == start_chips, \"Chips were created or lost!\"\n        return self.history\n\n    # ----- betting ---------------------------------------------------------\n    def _needs_action(self, index, current_bet, acted):\n        player = self.players[index]\n        opponent = self.players[1 - index]\n        if player.folded or player.chips == 0:\n            return False\n        if player.street_bet < current_bet:\n            return True\n        # Still owed a turn (e.g. the big blind's option), unless the opponent\n        # is all-in and there is no one left to bet against.\n        return index not in acted and opponent.chips > 0\n\n    def _legal_actions(\n        self,\n        player,\n        opponent,\n        current_bet,\n        to_call,\n        bets_made,\n        min_raise_to,\n        max_raise_to,\n    ):\n        # Raising needs chips beyond the call and an opponent who can respond.\n        can_raise = player.chips > to_call and opponent.chips > 0\n        if self.betting == \"limit\":\n            sized = can_raise and bets_made < self.bet_cap\n            all_in = False  # limit has no all-in move: you run out by calling/betting\n        else:\n            sized = can_raise and max_raise_to >= min_raise_to\n            all_in = can_raise\n        actions = [\"check\"] if to_call == 0 else [\"fold\", \"call\"]\n        if sized:\n            # The blinds count as a bet, so pre-flop it is always a raise.\n            actions.append(\"bet\" if current_bet == 0 else \"raise\")\n        if all_in:\n            actions.append(\"all-in\")\n        return tuple(actions)\n\n    def _resolve_action(self, player, action, state):\n        \"\"\"Validate an agent's answer and return (kind, raise_to).\"\"\"\n        kind, amount = action if isinstance(action, tuple) else (action, None)\n        if kind not in state.legal_actions:\n            raise ValueError(\n                f\"{player.name} chose illegal action {action!r}; \"\n                f\"legal: {state.legal_actions}\"\n            )\n        if kind == \"all-in\":\n            return kind, state.max_raise_to\n        if kind in (\"bet\", \"raise\"):\n            if amount is None or self.betting == \"limit\":\n                amount = state.min_raise_to\n            if not state.min_raise_to <= amount <= state.max_raise_to:\n                raise ValueError(\n                    f\"{player.name}: {kind} to {amount} is outside \"\n                    f\"{state.min_raise_to}-{state.max_raise_to}\"\n                )\n        return kind, amount\n\n    @staticmethod\n    def _describe(kind, player, called):\n        if kind == \"call\":\n            text = f\"call {called}\"\n        elif kind == \"bet\":\n            text = f\"bet {player.street_bet}\"\n        elif kind == \"raise\":\n            text = f\"raise to {player.street_bet}\"\n        elif kind == \"all-in\":\n            return f\"all-in ({player.street_bet})\"\n        else:\n            return kind\n        return text + (\" (all-in)\" if player.is_all_in else \"\")\n\n    def _betting_round(self, street):\n        if street == \"Pre-Flop\":\n            # A short-stacked big blind may have posted less than a full blind.\n            current_bet = max(p.street_bet for p in self.players)\n            bets_made, actor = 1, self.button\n        else:\n            current_bet, bets_made, actor = 0, 0, 1 - self.button\n        # No-limit: the next raise must be at least this big (starts at 1 BB).\n        last_raise = self.big_blind\n        acted = set()\n\n        while len(self._live_players()) > 1 and any(\n            self._needs_action(i, current_bet, acted) for i in (0, 1)\n        ):\n            if self._needs_action(actor, current_bet, acted):\n                player = self.players[actor]\n                opponent = self.players[1 - actor]\n                to_call = current_bet - player.street_bet\n                all_in_to = player.street_bet + player.chips\n                if self.betting == \"limit\":\n                    min_raise_to = max_raise_to = min(\n                        current_bet + self._bet_size(street), all_in_to\n                    )\n                else:\n                    min_raise_to, max_raise_to = current_bet + last_raise, all_in_to\n                legal = self._legal_actions(\n                    player,\n                    opponent,\n                    current_bet,\n                    to_call,\n                    bets_made,\n                    min_raise_to,\n                    max_raise_to,\n                )\n                state = TableState(\n                    street=street,\n                    betting=self.betting,\n                    board=tuple(self.board),\n                    hole_cards=tuple(player.hole_cards),\n                    pot=self.pot,\n                    to_call=to_call,\n                    current_bet=current_bet,\n                    street_bet=player.street_bet,\n                    min_raise_to=min_raise_to,\n                    max_raise_to=max_raise_to,\n                    bets_this_street=bets_made,\n                    chips=player.chips,\n                    opponent_chips=opponent.chips,\n                    legal_actions=legal,\n                    action_history=tuple(self.action_log),\n                )\n                action = yield player, state\n                kind, raise_to = self._resolve_action(player, action, state)\n\n                called = 0\n                if kind == \"fold\":\n                    player.folded = True\n                elif kind == \"call\":\n                    called = player.commit(to_call)\n                elif kind in (\"bet\", \"raise\", \"all-in\"):\n                    player.commit(raise_to - player.street_bet)\n                    if player.street_bet > current_bet:  # (an all-in may only call)\n                        increment = player.street_bet - current_bet\n                        # Only a full-size raise sets a new minimum raise.\n                        last_raise = max(last_raise, increment)\n                        current_bet = player.street_bet\n                        bets_made += 1\n                        acted = set()  # the opponent must respond to the raise\n\n                acted.add(actor)\n                self.action_log.append((street, player.name, kind, player.street_bet))\n                self.log(\n                    f\"  {player.name}: {self._describe(kind, player, called)}\"\n                    f\" | pot {self.pot}\"\n                )\n            actor = 1 - actor\n\n    # ----- settlement ------------------------------------------------------\n    def _return_uncalled_chips(self):\n        \"\"\"Give back the part of a bet the opponent never matched.\"\"\"\n        high, low = sorted(self.players, key=lambda p: p.total_bet, reverse=True)\n        excess = high.total_bet - low.total_bet\n        if excess > 0:\n            high.total_bet -= excess\n            high.chips += excess\n\n    def _base_record(self):\n        return {\n            \"hand\": self.hand_number,\n            \"button\": self.players[self.button].name,\n            \"seats\": [player.name for player in self.players],\n            \"hole_cards\": {p.name: list(p.hole_cards) for p in self.players},\n            \"board\": list(self.board),\n            \"actions\": list(self.action_log),\n        }\n\n    def _collect_pot(self):\n        pot = self.pot\n        for player in self.players:\n            player.total_bet = 0\n        return pot\n\n    def _finish_by_fold(self):\n        self._return_uncalled_chips()\n        winner = self._live_players()[0]\n        pot = self._collect_pot()\n        winner.chips += pot\n        self.log(f\"{winner.name} wins {pot} (opponent folded)\")\n        return {\n            **self._base_record(),\n            \"result\": \"fold\",\n            \"pot\": pot,\n            \"winners\": [winner.name],\n            \"hand_ranks\": None,\n        }\n\n    def _showdown(self):\n        self._return_uncalled_chips()\n        hands = {p.name: p.hole_cards for p in self.players}\n        winners, hand_ranks = HandEvaluator.showdown(hands, self.board)\n        pot = self._collect_pot()\n        share, odd_chip = divmod(pot, len(winners))\n        for player in self.players:\n            if player.name in winners:\n                player.chips += share\n        if odd_chip:  # the odd chip goes to the player out of position\n            self.players[1 - self.button].chips += odd_chip\n\n        self.log(f\"--- Showdown on {format_cards(self.board)}\")\n        for name, rank in hand_ranks.items():\n            self.log(\n                f\"  {name}: {format_cards(hands[name])} -> {rank.describe()}\"\n                f\" [{format_cards(rank.cards)}]\"\n            )\n        verb = \"split\" if len(winners) > 1 else \"wins\"\n        self.log(f\"{' & '.join(winners)} {verb} {pot}\")\n        return {\n            **self._base_record(),\n            \"result\": \"showdown\",\n            \"pot\": pot,\n            \"winners\": winners,\n            \"hand_ranks\": hand_ranks,\n        }"
