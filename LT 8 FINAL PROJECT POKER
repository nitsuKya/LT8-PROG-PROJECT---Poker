      "source": "# Cell 5: Monte Carlo equity engine (Teammate 1)\nBOARD_SIZES = (0, 3, 4, 5)  # pre-flop, flop, turn, river\n\n\ndef to_cards(cards, label=\"cards\"):\n    \"\"\"Turn input into a list of Card objects.\n\n    Accepts None, a string like \"Ah Kd\", a list like [\"Ah\", \"Kd\"], or Card objects.\n    \"\"\"\n    if cards is None:\n        return []\n    if isinstance(cards, str):\n        cards = cards.split()\n\n    result = []\n    for card in cards:\n        if isinstance(card, str):\n            if len(card) != 2:\n                raise ValueError(f\"Invalid card {card!r} in {label}: use e.g. 'Ah', 'Td', '7c'.\")\n            try:\n                result.append(Card.from_str(card))\n            except (KeyError, ValueError):\n                raise ValueError(f\"Invalid card {card!r} in {label}.\") from None\n        elif hasattr(card, \"rank\") and hasattr(card, \"suit\"):\n            # Rebuild so it matches the current Card class (in case Cell 2 was re-run).\n            result.append(Card(card.rank, card.suit))\n        else:\n            raise ValueError(f\"Invalid card {card!r} in {label}.\")\n    return result\n\n\ndef calculate_equity(\n    hole_cards,\n    community_cards,\n    num_simulations=10000,\n    opponent_cards=None,\n    seed=None,\n):\n    \"\"\"Estimate win / tie / loss percentages for `hole_cards` heads-up.\n\n    hole_cards      : your 2 cards, e.g. \"Ah Kh\" or [Card, Card]\n    community_cards : known board: 0 (pre-flop), 3 (flop), 4 (turn) or 5 (river) cards\n    num_simulations : how many random boards to play out (default 10,000)\n    opponent_cards  : None = opponent holds 2 random unseen cards; or their 2 known cards\n    seed            : optional; the same seed gives the same result every run\n\n    Returns {\"win\": float, \"tie\": float, \"loss\": float} as percentages (0-100) summing to 100.\n    \"\"\"\n    # ---- 1. Validate the input ------------------------------------------\n    hero = to_cards(hole_cards, \"hole_cards\")\n    board = to_cards(community_cards, \"community_cards\")\n    villain = to_cards(opponent_cards, \"opponent_cards\")\n\n    if len(hero) != 2:\n        raise ValueError(f\"hole_cards must be exactly 2 cards, got {len(hero)}.\")\n    if len(board) not in BOARD_SIZES:\n        raise ValueError(f\"community_cards must be 0, 3, 4 or 5 cards, got {len(board)}.\")\n    if opponent_cards is not None and len(villain) != 2:\n        raise ValueError(f\"opponent_cards must be exactly 2 cards, got {len(villain)}.\")\n    if isinstance(num_simulations, bool) or not isinstance(num_simulations, int):\n        raise ValueError(\"num_simulations must be a whole number.\")\n    if num_simulations < 1:\n        raise ValueError(\"num_simulations must be at least 1.\")\n\n    known = hero + board + villain\n    if len(set(known)) != len(known):\n        raise ValueError(\"The same card appears more than once.\")\n\n    # ---- 2. Set up ONCE, before the loop (performance pass) -------------\n    # Unseen deck = full 52 cards minus every known card. Built a single time;\n    # inside the loop we only draw a few cards from it, never copy/shuffle it.\n    known_set = set(known)\n    unseen = [card for card in Deck().cards if card not in known_set]\n\n    rng = random.Random(seed)  # private generator: doesn't affect other code\n    cards_to_complete_board = 5 - len(board)\n    random_opponent = opponent_cards is None\n    cards_per_draw = cards_to_complete_board + (2 if random_opponent else 0)\n\n    # Score cache: the best hand depends only on WHICH 7 cards a player has,\n    # so a repeated 7-card hand is looked up instead of re-evaluated.\n    score_cache = {}\n\n    def score(hole, full_board):\n        key = frozenset(hole + full_board)\n        value = score_cache.get(key)\n        if value is None:\n            # HandRank.key = (category, tiebreak): a bigger tuple is a better hand\n            value = HandEvaluator.best_hand(hole, full_board).key\n            score_cache[key] = value\n        return value\n\n    # ---- 3. The Monte Carlo loop -----------------------------------------\n    wins = ties = losses = 0\n    sample = rng.sample  # local name: slightly faster in a tight loop\n\n    for _ in range(num_simulations):\n        # One draw without replacement: opponent and board cards never collide.\n        drawn = sample(unseen, cards_per_draw)\n\n        if random_opponent:\n            opponent = drawn[:2]\n            full_board = board + drawn[2:]\n        else:\n            opponent = villain\n            full_board = board + drawn\n\n        # ---- 4. Showdown: score both 7-card hands with the evaluator ----\n        hero_score = score(hero, full_board)\n        opponent_score = score(opponent, full_board)\n\n        if hero_score > opponent_score:\n            wins += 1\n        elif hero_score == opponent_score:\n            ties += 1\n        else:\n            losses += 1\n\n    # ---- 5. Counts -> percentages ----------------------------------------\n    return {\n        \"win\": 100.0 * wins / num_simulations,\n        \"tie\": 100.0 * ties / num_simulations,\n        \"loss\": 100.0 * losses / num_simulations,\n    }\n\n\ndef show_equity(label, result):\n    equity = result[\"win\"] + result[\"tie\"] / 2  # ties count as half a pot\n    print(f\"{label:<34} win {result['win']:5.1f}%  tie {result['tie']:4.1f}%  \"\n          f\"loss {result['loss']:5.1f}%  | equity {equity:5.1f}%\")\n\n\nshow_equity(\"AA vs KK, pre-flop\", calculate_equity(\"As Ah\", \"\", opponent_cards=\"Ks Kh\", seed=1))\nshow_equity(\"AA vs random hand, pre-flop\", calculate_equity(\"As Ah\", \"\", seed=1))\nshow_equity(\"AhKh vs QQ, flop Qh 7h 2c\", calculate_equity(\"Ah Kh\", \"Qh 7h 2c\", opponent_cards=\"Qs Qd\", seed=1))\nshow_equity(\"9s8s vs random, turn 7s 6d 2s Kc\", calculate_equity(\"9s 8s\", \"7s 6d 2s Kc\", seed=1))\n"
