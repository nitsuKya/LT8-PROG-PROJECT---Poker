      "source": "# Cell 3: Hand evaluator (best 5 of up to 7 cards)\nclass HandCategory(IntEnum):\n    HIGH_CARD = 0\n    ONE_PAIR = 1\n    TWO_PAIR = 2\n    THREE_OF_A_KIND = 3\n    STRAIGHT = 4\n    FLUSH = 5\n    FULL_HOUSE = 6\n    FOUR_OF_A_KIND = 7\n    STRAIGHT_FLUSH = 8\n    ROYAL_FLUSH = 9\n\n    @property\n    def label(self):\n        return self.name.replace(\"_\", \" \").title().replace(\" Of A \", \" of a \")\n\n\n@total_ordering\n@dataclass(frozen=True, eq=False)\nclass HandRank:\n    \"\"\"The value of a 5-card hand.\n\n    Hands compare on (category, tiebreak). `tiebreak` lists the ranks that\n    matter in order of importance, e.g. Two Pair K-K-7-7-A -> (13, 7, 14).\n    \"\"\"\n\n    category: HandCategory\n    tiebreak: tuple\n    cards: tuple  # the five cards, ordered for display\n\n    @property\n    def key(self):\n        return (self.category, self.tiebreak)\n\n    def __eq__(self, other):\n        return self.key == other.key\n\n    def __lt__(self, other):\n        return self.key < other.key\n\n    @property\n    def strength(self):\n        \"\"\"A continuous score in [0, 10): category + kicker fraction.\n\n        Every tiebreak rank is < 15, so the base-15 fraction preserves the\n        exact lexicographic ordering of the hands.\n        \"\"\"\n        fraction = sum(rank / 15 ** (i + 1) for i, rank in enumerate(self.tiebreak))\n        return self.category + fraction\n\n    def describe(self):\n        cat, t = self.category, self.tiebreak\n        name, plural = RANK_NAMES, RANK_PLURALS\n        kickers = lambda ranks: \" \".join(RANKS[r - 2] for r in ranks)\n        if cat == HandCategory.ROYAL_FLUSH:\n            return \"Royal Flush\"\n        if cat == HandCategory.STRAIGHT_FLUSH:\n            return f\"Straight Flush, {name[t[0]]} high\"\n        if cat == HandCategory.FOUR_OF_A_KIND:\n            return f\"Four {plural[t[0]]}, kicker {kickers(t[1:])}\"\n        if cat == HandCategory.FULL_HOUSE:\n            return f\"Full House, {plural[t[0]]} full of {plural[t[1]]}\"\n        if cat == HandCategory.FLUSH:\n            return f\"Flush, {kickers(t)}\"\n        if cat == HandCategory.STRAIGHT:\n            return f\"Straight, {name[t[0]]} high\"\n        if cat == HandCategory.THREE_OF_A_KIND:\n            return f\"Three {plural[t[0]]}, kickers {kickers(t[1:])}\"\n        if cat == HandCategory.TWO_PAIR:\n            return f\"Two Pair, {plural[t[0]]} & {plural[t[1]]}, kicker {kickers(t[2:])}\"\n        if cat == HandCategory.ONE_PAIR:\n            return f\"Pair of {plural[t[0]]}, kickers {kickers(t[1:])}\"\n        return f\"High Card, {kickers(t)}\"\n\n    def __repr__(self):\n        return f\"<{self.describe()} | {format_cards(self.cards)}>\"\n\n\nclass HandEvaluator:\n    \"\"\"Stateless poker hand evaluation utilities.\"\"\"\n\n    @staticmethod\n    def evaluate_five(five):\n        if len(five) != 5:\n            raise ValueError(\"evaluate_five needs exactly 5 cards.\")\n        ranks = sorted((card.rank for card in five), reverse=True)\n        counts = Counter(ranks)\n        # Group ranks by (multiplicity, rank): quads before trips before pairs.\n        groups = sorted(\n            counts.items(), key=lambda item: (item[1], item[0]), reverse=True\n        )\n        grouped_ranks = tuple(rank for rank, _ in groups)\n        shape = [count for _, count in groups]\n\n        is_flush = len({card.suit for card in five}) == 1\n        straight_high = None\n        if len(counts) == 5:\n            if ranks[0] - ranks[4] == 4:\n                straight_high = ranks[0]\n            elif ranks == [14, 5, 4, 3, 2]:  # the wheel: A-2-3-4-5\n                straight_high = 5\n\n        # Display order: biggest group first; in a wheel the Ace goes last.\n        def display_key(card):\n            rank = 1 if straight_high == 5 and card.rank == 14 else card.rank\n            return (counts[card.rank], rank, card.suit)\n\n        ordered = tuple(sorted(five, key=display_key, reverse=True))\n\n        if straight_high and is_flush:\n            category = (\n                HandCategory.ROYAL_FLUSH\n                if straight_high == 14\n                else HandCategory.STRAIGHT_FLUSH\n            )\n            return HandRank(category, (straight_high,), ordered)\n        if shape == [4, 1]:\n            return HandRank(HandCategory.FOUR_OF_A_KIND, grouped_ranks, ordered)\n        if shape == [3, 2]:\n            return HandRank(HandCategory.FULL_HOUSE, grouped_ranks, ordered)\n        if is_flush:\n            return HandRank(HandCategory.FLUSH, tuple(ranks), ordered)\n        if straight_high:\n            return HandRank(HandCategory.STRAIGHT, (straight_high,), ordered)\n        if shape == [3, 1, 1]:\n            return HandRank(HandCategory.THREE_OF_A_KIND, grouped_ranks, ordered)\n        if shape == [2, 2, 1]:\n            return HandRank(HandCategory.TWO_PAIR, grouped_ranks, ordered)\n        if shape == [2, 1, 1, 1]:\n            return HandRank(HandCategory.ONE_PAIR, grouped_ranks, ordered)\n        return HandRank(HandCategory.HIGH_CARD, tuple(ranks), ordered)\n\n    @classmethod\n    def best_hand(cls, hole_cards, board):\n        \"\"\"Best 5-card HandRank from 2 hole cards + 3..5 board cards.\"\"\"\n        cards = list(hole_cards) + list(board)\n        if not 5 <= len(cards) <= 7:\n            raise ValueError(f\"Need 5-7 cards to evaluate, got {len(cards)}.\")\n        if len(set(cards)) != len(cards):\n            raise ValueError(\"Duplicate cards detected.\")\n        return max(cls.evaluate_five(combo) for combo in combinations(cards, 5))\n\n    @classmethod\n    def showdown(cls, hands, board):\n        \"\"\"Evaluate {name: hole_cards}; return (winner_names, {name: HandRank}).\"\"\"\n        results = {name: cls.best_hand(hole, board) for name, hole in hands.items()}\n        best = max(results.values())\n        winners = [name for name, rank in results.items() if rank == best]\n        return winners, results"
    },
