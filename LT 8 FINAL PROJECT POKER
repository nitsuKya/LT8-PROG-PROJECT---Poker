      "source": "# Cell 10: Horizontal Showdown Comparison Bar Chart\nSEAT_COLORS = [\"#2a78d6\", \"#eb6834\"]  # seat 1 blue, seat 2 orange\nINK, MUTED, GRID = \"#1f1f1e\", \"#6b6a64\", \"#e4e3de\"\n\n\ndef plot_showdown(record, ax=None):\n    \"\"\"Bar length = hand strength (category + kicker fraction).\n\n    Bars are colored by seat, so a player keeps the same color in every hand.\n    \"\"\"\n    if record[\"hand_ranks\"] is None:\n        print(f\"Hand #{record['hand']} ended by a fold: nothing to compare.\")\n        return None\n    ranks = record[\"hand_ranks\"]\n    names = record[\"seats\"]\n    if ax is None:\n        _, ax = plt.subplots(figsize=(11, 3.6))\n\n    for y, name in enumerate(names):\n        rank = ranks[name]\n        ax.barh(y, rank.strength, height=0.5, color=SEAT_COLORS[y], zorder=3)\n        tag = \"\"\n        if name in record[\"winners\"]:\n            tag = \"  SPLIT\" if len(record[\"winners\"]) > 1 else \"  WINNER\"\n        ax.text(\n            rank.strength + 0.08,\n            y,\n            f\"{rank.strength:.3f}{tag}\",\n            va=\"center\",\n            ha=\"left\",\n            fontsize=10,\n            color=INK,\n            fontweight=\"bold\" if tag else \"normal\",\n        )\n\n    ax.set_yticks(range(len(names)))\n    ax.set_yticklabels(\n        [\n            f\"{name}  ({format_cards(record['hole_cards'][name])})\\n\"\n            f\"{ranks[name].describe()}\\n{format_cards(ranks[name].cards)}\"\n            for name in names\n        ],\n        fontsize=10,\n        color=INK,\n    )\n    ax.invert_yaxis()\n\n    ax.set_xlim(0, 10.8)\n    # Gridlines mark category boundaries; labels sit in the middle of each band.\n    ax.set_xticks(range(11))\n    ax.set_xticklabels([])\n    ax.set_xticks([c + 0.5 for c in HandCategory], minor=True)\n    ax.set_xticklabels(\n        [c.label.replace(\" \", \"\\n\", 1) for c in HandCategory],\n        minor=True,\n        fontsize=8.5,\n        color=MUTED,\n    )\n   