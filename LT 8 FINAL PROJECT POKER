      "source": "# Cell 2: Card & Deck classes\n@dataclass(frozen=True, order=True)\nclass Card:\n    \"\"\"An immutable playing card. Cards sort by rank first, then by suit.\"\"\"\n\n    rank: int  # 2..14 (14 = Ace)\n    suit: str  # one of 'c', 'd', 'h', 's'\n\n    def __post_init__(self):\n        if self.rank not in RANK_NAMES:\n            raise ValueError(f\"Invalid rank: {self.rank}\")\n        if self.suit not in SUITS:\n            raise ValueError(f\"Invalid suit: {self.suit}\")\n\n    @classmethod\n    def from_str(cls, text):\n        \"\"\"Build a card from short notation, e.g. 'Ah', 'Td', '7c'.\"\"\"\n        return cls(RANK_VALUES[text[0].upper()], text[1].lower())\n\n    @property\n    def rank_char(self):\n        return RANKS[self.rank - 2]\n\n    def __str__(self):\n        return f\"{self.rank_char}{SUIT_SYMBOLS[self.suit]}\"\n\n    def __repr__(self):\n        return f\"Card('{self.rank_char}{self.suit}')\"\n\n\ndef parse_cards(text):\n    \"\"\"Parse a space-separated card string: parse_cards('Ah Kd 7c').\"\"\"\n    return [Card.from_str(token) for token in text.split()]\n\n\ndef format_cards(cards):\n    return \" \".join(str(card) for card in cards)\n\n\nclass Deck:\n    \"\"\"A standard 52-card deck with its own random generator (seedable).\"\"\"\n\n    def __init__(self, rng=None):\n        self.rng = rng or random.Random()\n        self.cards = []\n        self.reset()\n\n    def reset(self):\n        self.cards = [Card(rank, suit) for suit in SUITS for rank in RANK_NAMES]\n\n    def shuffle(self):\n        self.rng.shuffle(self.cards)\n\n    def deal(self, count=1):\n        if count > len(self.cards):\n            raise ValueError(\"Not enough cards left in the deck.\")\n        return [self.cards.pop() for _ in range(count)]\n\n    def burn(self):\n        self.deal(1)\n\n    def __len__(self):\n        return len(self.cards)\n\n\ndeck = Deck(random.Random(42))\ndeck.shuffle()\nprint(\"Sorted sample:\", format_cards(sorted(deck.deal(5), reverse=True)))\nprint(\"Cards left:\", len(deck))"
