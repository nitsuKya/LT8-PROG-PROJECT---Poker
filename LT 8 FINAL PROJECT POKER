      "source": "# Cell 12: Interactive table UI (1 human vs. AI)\nimport html\n\nimport ipywidgets as widgets\nfrom IPython.display import display\n\nFELT, FELT_EDGE, FELT_TEXT = \"#1f5f3f\", \"#123d27\", \"#f4f1ea\"\nCARD_RED, CARD_BLACK = \"#c8102e\", \"#16161a\"\n\n\ndef action_phrase(kind, street_total):\n    \"\"\"'raises to 24', 'goes all-in (200)', ... for the status bar.\"\"\"\n    return {\n        \"fold\": \"folds\",\n        \"check\": \"checks\",\n        \"call\": \"calls\",\n        \"bet\": f\"bets {street_total}\",\n        \"raise\": f\"raises to {street_total}\",\n        \"all-in\": f\"goes all-in ({street_total})\",\n    }[kind]\n\n\ndef card_html(card=None, face_down=False):\n    \"\"\"One playing card as inline HTML (an empty slot when card is None).\"\"\"\n    box = (\n        \"display:inline-flex;flex-direction:column;align-items:center;\"\n        \"justify-content:center;width:48px;height:68px;margin:0 3px;\"\n        \"border-radius:7px;box-sizing:border-box;vertical-align:middle;\"\n        \"font-family:system-ui,sans-serif;font-weight:700;line-height:1.05;\"\n    )\n    if card is None:\n        return f'<div style=\"{box}border:2px dashed rgba(255,255,255,.25);\"></div>'\n    if face_down:\n        back = (\n            \"background:repeating-linear-gradient(45deg,#8c1d2c 0 5px,\"\n            \"#a83242 5px 10px);border:3px solid #f4f1ea;\"\n        )\n        return f'<div style=\"{box}{back}\"></div>'\n    color = CARD_RED if card.suit in \"hd\" else CARD_BLACK\n    rank = \"10\" if card.rank == 10 else card.rank_char\n    return (\n        f'<div style=\"{box}background:#fdfcf8;border:1px solid #c9c6bc;'\n        f'color:{color};font-size:19px;\">{rank}'\n        f'<span style=\"font-size:22px\">{SUIT_SYMBOLS[card.suit]}</span></div>'\n    )\n\n\nclass PokerTableUI:\n    \"\"\"A clickable heads-up table for one human seat against one bot.\n\n    The UI drives GameEngine.hand_steps(): bot decisions are answered\n    automatically, and the generator stays paused on the human's turn until\n    a button is clicked. The bot's hole cards stay face down unless the hand\n    reaches showdown.\n    \"\"\"\n\n    def __init__(self, engine):\n        self.engine = engine\n        self.human = next(p for p in engine.players if p.agent.interactive)\n        self.bot = next(p for p in engine.players if p is not self.human)\n        self.starting_chips = {p.name: p.chips for p in engine.players}\n        self.steps = None\n        self.request = None  # (player, TableState) while the human must act\n        self.record = None  # the finished hand's record\n\n        def make_button(label, style):\n            # Each button needs its own Layout: a shared one would hide or\n            # show all buttons together.\n            return widgets.Button(\n                description=label,\n                button_style=style,\n                layout=widgets.Layout(width=\"150px\", height=\"40px\"),\n            )\n\n        self.fold_btn = make_button(\"Fold\", \"\")\n        self.passive_btn = make_button(\"Check\", \"info\")\n        self.aggressive_btn = make_button(\"Bet\", \"warning\")\n        self.all_in_btn = make_button(\"All-in\", \"danger\")\n        self.next_btn = make_button(\"Deal next hand\", \"success\")\n        self.fold_btn.on_click(lambda _: self._act(\"fold\"))\n        self.passive_btn.on_click(lambda _: self._act(self.passive_action))\n        self.aggressive_btn.on_click(lambda _: self._act(self._sized_action()))\n        self.all_in_btn.on_click(lambda _: self._act(\"all-in\"))\n        self.next_btn.on_click(lambda _: self._next_hand())\n        self.passive_action = self.aggressive_action = None\n\n        # No-limit sizing: a slider for the raise-to amount plus quick presets.\n        self.size_slider = widgets.IntSlider(\n            description=\"Raise to\",\n            continuous_update=True,\n            layout=widgets.Layout(width=\"330px\"),\n        )\n        self.size_slider.observe(lambda _: self._label_aggressive(), names=\"value\")\n        presets = []\n        for label, fraction in (\n            (\"Min\", None),\n            (\"\u00bd Pot\", 0.5),\n            (\"\u00be Pot\", 0.75),\n            (\"Pot\", 1.0),\n        ):\n            preset = widgets.Button(\n                description=label, layout=widgets.Layout(width=\"64px\")\n            )\n            preset.on_click(lambda _, f=fraction: self._preset(f))\n            presets.append(preset)\n        self.sizing_row = widgets.HBox(\n            [self.size_slider, *presets], layout=widgets.Layout(gap=\"6px\")\n        )\n\n        self.table = widgets.HTML()\n        self.log_box = widgets.HTML()\n        self.chart_out = widgets.Output()\n        controls = widgets.HBox(\n            [\n                self.fold_btn,\n                self.passive_btn,\n                self.aggressive_btn,\n                self.all_in_btn,\n                self.next_btn,\n            ],\n            layout=widgets.Layout(gap=\"8px\", margin=\"8px 0 4px\"),\n        )\n        self.root = widgets.VBox(\n            [self.table, controls, self.sizing_row, self.log_box, self.chart_out]\n        )\n\n    # ----- game flow -------------------------------------------------------\n    def show(self):\n        display(self.root)\n        self._next_hand()\n\n    def _next_hand(self):\n        with self.chart_out:\n            self.chart_out.clear_output()\n            if any(p.chips == 0 for p in self.engine.players):\n                self._new_game()\n            self.record = None\n            self.steps = self.engine.hand_steps()\n            self._advance(None)\n\n    def _new_game(self):\n        for player in self.engine.players:\n            player.chips = self.starting_chips[player.name]\n        self.engine.hand_number = 0\n        self.engine.history = []\n\n    def _act(self, action):\n        if self.request is None or action is None:\n            return\n        with self.chart_out:\n            self._advance(action)\n\n    def _sized_action(self):\n        if self.aggressive_action is None:\n            return None\n        return self.aggressive_action, self.size_slider.value\n\n    def _preset(self, fraction):\n        if self.request is None:\n            return\n        _, state = self.request\n        self.size_slider.value = (\n            state.min_raise_to\n            if fraction is None\n            else state.raise_to_for_pot_fraction(fraction)\n        )\n\n    def _advance(self, action):\n        \"\"\"Send an action, then let the bot play until it's our turn.\"\"\"\n        try:\n            player, state = self.steps.send(action)\n            while not player.agent.interactive:\n                player, state = self.steps.send(player.agent.decide(state))\n            self.request = (player, state)\n        except StopIteration as finished:\n            self.request = None\n            self.record = finished.value\n        self._render()\n        if self.record and self.record[\"result\"] == \"showdown\":\n            plot_showdown(self.record)\n            plt.show()\n\n    # ----- rendering -------------------------------------------------------\n    def _render(self):\n        self.table.value = self._table_html()\n        self.log_box.value = self._log_html()\n        self._update_buttons()\n\n    def _seat_html(self, player, reveal):\n        if self.record:\n            on_button = self.record[\"button\"] == player.name\n        else:\n            on_button = self.engine.players[self.engine.button] is player\n        dealer = (\n            ' <span style=\"background:#f4f1ea;color:#16161a;border-radius:50%;'\n            'padding:1px 6px;font-size:11px;font-weight:700\">D</span>'\n            if on_button\n            else \"\"\n        )\n        cards = player.hole_cards or [None, None]\n        hidden = not reveal and bool(player.hole_cards)\n        cards_html = \"\".join(card_html(c, face_down=hidden) for c in cards)\n        bet = (\n            f'<span style=\"opacity:.8\">bet {player.street_bet}</span>'\n            if player.street_bet and not self.record\n            else \"\"\n        )\n        folded = ' <span style=\"opacity:.7\">(folded)</span>' if player.folded else \"\"\n        return (\n            f'<div style=\"display:flex;align-items:center;gap:14px;\">'\n            f'<div>{cards_html}</div><div style=\"line-height:1.5\">'\n            f\"<b>{html.escape(player.name)}</b>{dealer}{folded}<br>\"\n            f\"{player.chips} chips &nbsp;{bet}</div></div>\"\n        )\n\n    def _table_html(self):\n        showdown = bool(self.record) and self.record[\"result\"] == \"showdown\"\n        board = list(self.engine.board) + [None] * (5 - len(self.engine.board))\n        pot = self.record[\"pot\"] if self.record else self.engine.pot\n        street = \"Hand over\" if self.record else self.engine.street\n        # Chips already in the pot this hand still count as ours until it ends.\n        net = (\n            self.human.chips\n            + self.human.total_bet\n            - self.starting_chips[self.human.name]\n        )\n        return (\n            f'<div style=\"background:{FELT};border:6px solid {FELT_EDGE};'\n            f\"border-radius:18px;padding:16px 20px;color:{FELT_TEXT};\"\n            f'font-family:system-ui,sans-serif;font-size:14px;max-width:640px;\">'\n            f'<div style=\"display:flex;justify-content:space-between;opacity:.85;'\n            f'font-size:12px;\"><span>Hand #{self.engine.hand_number} &middot; '\n            f\"{street}</span><span>Blinds {self.engine.small_blind}/\"\n            f\"{self.engine.big_blind} &middot; Session {net:+d}</span></div>\"\n            f'<div style=\"margin:12px 0\">{self._seat_html(self.bot, showdown)}</div>'\n            f'<div style=\"text-align:center;margin:18px 0\">'\n            f\"{''.join(card_html(c) for c in board)}\"\n            f'<div style=\"margin-top:8px;font-size:16px\"><b>Pot: {pot}</b></div></div>'\n            f'<div style=\"margin:12px 0\">{self._seat_html(self.human, True)}</div>'\n            f'<div style=\"margin-top:10px;padding:8px 12px;border-radius:8px;'\n            f'background:rgba(0,0,0,.28);font-size:15px\">{self._status()}</div>'\n            f\"</div>\"\n        )\n\n    def _status(self):\n        if self.request:\n            _, state = self.request\n            last = next(\n                (a for a in reversed(self.engine.action_log) if a[1] == self.bot.name),\n                None,\n            )\n            prefix = (\n                f\"{html.escape(self.bot.name)} {action_phrase(last[2], last[3])}. \"\n                if last and last[0] == state.street\n                else \"\"\n            )\n            if state.to_call:\n                return f\"{prefix}<b>Your turn</b>: {min(state.to_call, state.chips)} to call.\"\n            return f\"{prefix}<b>Your turn</b>: check or bet.\"\n        record = self.record\n        if record[\"result\"] == \"fold\":\n            winner = record[\"winners\"][0]\n            loser = self.bot.name if winner == self.human.name else self.human.name\n            return f\"{html.escape(loser)} folded. <b>{html.escape(winner)} wins {record['pot']}.</b>\"\n        ranks = record[\"hand_ranks\"]\n        lines = [\n            f\"{html.escape(name)}: {rank.describe()}\" for name, rank in ranks.items()\n        ]\n        if len(record[\"winners\"]) > 1:\n            outcome = f\"<b>Split pot of {record['pot']}.</b>\"\n        else:\n            outcome = (\n                f\"<b>{html.escape(record['winners'][0])} wins {record['pot']}.</b>\"\n            )\n        if any(p.chips == 0 for p in self.engine.players):\n            outcome += \" Game over!\"\n        return \"<br>\".join(lines + [outcome])\n\n    def _log_html(self):\n        lines = [\n            html.escape(msg.strip())\n            for owner, msg in self.engine.hand_log\n            if self.engine.can_see(owner) and msg.strip()\n        ]\n        return (\n            '<div style=\"font-family:Consolas,monospace;font-size:12px;'\n            \"color:#3d3c38;background:#f4f2ec;border-radius:8px;\"\n            'padding:8px 12px;max-width:616px;line-height:1.45;\">'\n            + \"<br>\".join(lines[-14:])\n            + \"</div>\"\n        )\n\n    @staticmethod\n    def _show(widget, visible):\n        widget.layout.display = None if visible else \"none\"\n\n    def _update_buttons(self):\n        in_hand = self.request is not None\n        no_limit = self.engine.betting == \"no-limit\"\n        for btn in (self.fold_btn, self.passive_btn, self.aggressive_btn):\n            self._show(btn, in_hand)\n        self._show(self.all_in_btn, in_hand and no_limit)\n        self._show(self.next_btn, not in_hand)\n        if not in_hand:\n            self._show(self.sizing_row, False)\n            game_over = any(p.chips == 0 for p in self.engine.players)\n            self.next_btn.description = \"New game\" if game_over else \"Deal next hand\"\n            return\n\n        player, state = self.request\n        legal = state.legal_actions\n        self.fold_btn.disabled = \"fold\" not in legal\n        if \"check\" in legal:\n            self.passive_action, self.passive_btn.description = \"check\", \"Check\"\n        else:\n            amount = min(state.to_call, player.chips)\n            self.passive_action, self.passive_btn.description = \"call\", f\"Call {amount}\"\n\n        self.aggressive_action = next((a for a in (\"bet\", \"raise\") if a in legal), None)\n        self.aggressive_btn.disabled = self.aggressive_action is None\n        self.all_in_btn.disabled = \"all-in\" not in legal\n        self.all_in_btn.description = f\"All-in ({player.chips})\"\n        self._show(self.sizing_row, no_limit and self.aggressive_action is not None)\n        if self.aggressive_action is not None:\n            # Reset the range in an order the slider always accepts (min <= max).\n            self.size_slider.min = 0\n            self.size_slider.max = state.max_raise_to\n            self.size_slider.min = state.min_raise_to\n            self.size_slider.value = state.min_raise_to\n        self._label_aggressive()\n\n    def _label_aggressive(self):\n        if self.request is None:\n            return\n        _, state = self.request\n        if self.aggressive_action is None:\n            self.aggressive_btn.description = \"Raise\"\n            return\n        amount = (\n            self.size_slider.value\n            if self.engine.betting == \"no-limit\"\n            else state.min_raise_to\n        )\n        verb = \"Bet\" if self.aggressive_action == \"bet\" else \"Raise to\"\n        suffix = \" (all-in)\" if amount == state.max_raise_to else \"\"\n        self.aggressive_btn.description = f\"{verb} {amount}{suffix}\""
