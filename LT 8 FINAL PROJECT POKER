      "source": "# Cell 6: Equity engine testing\nimport time\n\n\ndef exact_vs_known(hero, board, villain):\n    \"\"\"Brute force: check EVERY possible runout (used to verify the Monte Carlo).\"\"\"\n    hero, board, villain = parse_cards(hero), parse_cards(board), parse_cards(villain)\n    known = set(hero + board + villain)\n    unseen = [c for c in Deck().cards if c not in known]\n    w = t = l = 0\n    for runout in combinations(unseen, 5 - len(board)):\n        full = board + list(runout)\n        h, v = HandEvaluator.best_hand(hero, full), HandEvaluator.best_hand(villain, full)\n        w, t, l = w + (h > v), t + (h == v), l + (h < v)\n    n = w + t + l\n    return {\"win\": 100 * w / n, \"tie\": 100 * t / n, \"loss\": 100 * l / n}\n\n\n# Output format: three float percentages that add up to 100.\nr = calculate_equity(\"Ah Kh\", \"\", num_simulations=2000, seed=1)\nassert set(r) == {\"win\", \"tie\", \"loss\"} and all(isinstance(v, float) for v in r.values())\nassert abs(sum(r.values()) - 100) < 1e-9\n\n# Known pre-flop matchups.\nr = calculate_equity(\"As Ah\", \"\", opponent_cards=\"Ks Kh\", seed=7)\nassert 80 <= r[\"win\"] <= 84, r  # AA vs KK ~82%\nr = calculate_equity(\"As Ah\", \"\", seed=7)\nassert 83 <= r[\"win\"] + r[\"tie\"] / 2 <= 87.5, r  # AA vs random ~85%\n\n# Monte Carlo agrees with an exact count of every runout (flop and turn).\nfor hero, board, villain in [(\"Ah Kh\", \"Qh 7h 2c\", \"Qs Qd\"), (\"9s 8s\", \"7s 6d 2s Kc\", \"Ac Ad\")]:\n    exact = exact_vs_known(hero, board, villain)\n    est = calculate_equity(hero, board, opponent_cards=villain, seed=3)\n    assert all(abs(est[k] - exact[k]) < 2 for k in exact), (est, exact)\n\n# River with both hands known: the answer is certain.\nassert calculate_equity(\"Ah Kh\", \"Qh Jh Th 3s 4d\", 500, \"2c 2d\") == {\"win\": 100.0, \"tie\": 0.0, \"loss\": 0.0}\nassert calculate_equity(\"2c 2d\", \"Qh Jh Th 3s 4d\", 500, \"Ah Kh\") == {\"win\": 0.0, \"tie\": 0.0, \"loss\": 100.0}\nassert calculate_equity(\"2c 3d\", \"As Ks Qs Js Ts\", 500, \"4h 5h\")[\"tie\"] == 100.0  # board plays\nassert calculate_equity(\"Ah Kh\", \"Qh Jh Th 3s 4d\", 1000, seed=1)[\"win\"] == 100.0  # royal vs anyone\n\n# Swapping the players mirrors the result; seeds and input styles are consistent.\na = calculate_equity(\"As Ah\", \"\", 3000, \"Ks Kh\", seed=9)\nb = calculate_equity(\"Ks Kh\", \"\", 3000, \"As Ah\", seed=9)\nassert (a[\"win\"], a[\"tie\"], a[\"loss\"]) == (b[\"loss\"], b[\"tie\"], b[\"win\"])\nassert (calculate_equity(\"Ah Kd\", \"7c 8c 9d\", 3000, seed=5)\n        == calculate_equity([\"Ah\", \"Kd\"], [\"7c\", \"8c\", \"9d\"], 3000, seed=5)\n        == calculate_equity(parse_cards(\"Ah Kd\"), parse_cards(\"7c 8c 9d\"), 3000, seed=5))\n\n# Invalid input is rejected with a clear ValueError.\nbad_calls = [\n    (\"Ah\", \"\"), (\"Ah Kh Qh\", \"\"), (\"Ah Kh\", \"2c 3c\"), (\"Ah Kh\", \"2c 3c 4c 5c 6c 7c\"),\n    (\"Ah Ah\", \"\"), (\"Ah Kh\", \"Ah 2c 3c\"), (\"Zz Kh\", \"\"), (\"Ax Kh\", \"\"), (\"10h Kh\", \"\"),\n]\nbad_kwargs = [dict(opponent_cards=\"Kh Qs\"), dict(opponent_cards=\"Qs\"),\n              dict(num_simulations=0), dict(num_simulations=2.5)]\nfor args, kwargs in [(c, {}) for c in bad_calls] + [((\"Ah Kh\", \"\"), k) for k in bad_kwargs]:\n    try:\n        calculate_equity(*args, **kwargs)\n    except ValueError:\n        continue\n    raise AssertionError(f\"Expected ValueError for {args} {kwargs}\")\n\n# Performance: 10,000 simulations on every street.\nfor label, board in [(\"Pre-Flop\", \"\"), (\"Flop\", \"Qh 7c 2d\"),\n                     (\"Turn\", \"Qh 7c 2d 9s\"), (\"River\", \"Qh 7c 2d 9s 3h\")]:\n    start = time.perf_counter()\n    calculate_equity(\"Ah Kh\", board, num_simulations=10000, seed=1)\n    print(f\"10,000 simulations, {label:<8}: {time.perf_counter() - start:.2f} s\")\n\nprint(\"\\nAll equity engine tests passed.\")\n"
