      "source": "# Cell 1: Imports & global configuration\nimport random\nfrom collections import Counter\nfrom dataclasses import dataclass\nfrom enum import IntEnum\nfrom functools import total_ordering\nfrom itertools import combinations\n\nimport matplotlib.pyplot as plt\n\nRANKS = \"23456789TJQKA\"\nRANK_VALUES = {char: value for value, char in enumerate(RANKS, start=2)}\nRANK_NAMES = {\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\",\n    10: \"Ten\",\n    11: \"Jack\",\n    12: \"Queen\",\n    13: \"King\",\n    14: \"Ace\",\n}\nRANK_PLURALS = {value: name + \"s\" for value, name in RANK_NAMES.items()}\nRANK_PLURALS[6] = \"Sixes\"\n\nSUITS = \"cdhs\"  # clubs < diamonds < hearts < spades (used only to sort)\nSUIT_SYMBOLS = {\"c\": \"\u2663\", \"d\": \"\u2666\", \"h\": \"\u2665\", \"s\": \"\u2660\"}\n\nSTREETS = (\"Pre-Flop\", \"Flop\", \"Turn\", \"River\")\nBOARD_CARDS_PER_STREET = {\"Pre-Flop\": 0, \"Flop\": 3, \"Turn\": 1, \"River\": 1}"
