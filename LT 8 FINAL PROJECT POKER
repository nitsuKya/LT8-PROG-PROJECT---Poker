      "source": "# Cell 14: Monte Carlo Convergence and Static Equity Analytics\n# Uses the notebook's existing Card, Deck, HandEvaluator, and calculate_equity.\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport random\nimport time\n\nANALYTICS_SEED = 2026\nCONVERGENCE_N = [10, 100, 1_000, 10_000]\nBASELINE_N = 100_000\nHEATMAP_N = 300  # quick approximation; increase for a smoother heatmap\nPOSTFLOP_N = 5_000\n\ndef equity_from_result(result):\n    # calculate_equity returns percentages; ties count as half.\n    return (result[\"win\"] + result[\"tie\"] / 2) / 100\n\n# ---- A. Error convergence: pocket aces vs random -------------------------\nprint(\"Running baseline and convergence experiment...\")\nbaseline_result = calculate_equity(\"As Ah\", \"\", num_simulations=BASELINE_N,\n                                   seed=ANALYTICS_SEED)\np_baseline = equity_from_result(baseline_result)\nprint(f\"Baseline (N={BASELINE_N:,}) equity: {p_baseline:.6f}\")\n\nconvergence_equities, convergence_errors = [], []\nfor n in CONVERGENCE_N:\n    result = calculate_equity(\"As Ah\", \"\", num_simulations=n,\n                              seed=ANALYTICS_SEED + n)\n    p_hat = equity_from_result(result)\n    error = abs(p_hat - p_baseline)\n    convergence_equities.append(p_hat)\n    convergence_errors.append(error)\n    print(f\"N={n:>6,}: estimated equity={p_hat:.6f}; absolute error={error:.6f}\")\n\n# Log-log plot. Absolute errors may be zero; use a small floor for plotting.\nplot_errors = np.maximum(convergence_errors, 1e-8)\nn_array = np.asarray(CONVERGENCE_N, dtype=float)\nreference_sqrt = plot_errors[0] * np.sqrt(n_array[0] / n_array)\nreference_inverse = plot_errors[0] * (n_array[0] / n_array)\n\nplt.figure(figsize=(8, 5.5))\nplt.loglog(n_array, plot_errors, \"o-\", label=\"Observed absolute error\")\nplt.loglog(n_array, reference_sqrt, \"--\", label=r\"Reference $N^{-1/2}$ (error/SE rate)\")\nplt.loglog(n_array, reference_inverse, \":\", label=r\"Reference $N^{-1}$ (variance rate)\")\nplt.xlabel(\"Number of simulations, N\")\nplt.ylabel(r\"$|\\hat p_N-\\hat p_{100000}|$\")\nplt.title(\"Monte Carlo Equity Error Convergence: AA vs Random\")\nplt.grid(True, which=\"both\", alpha=0.3)\nplt.legend()\nplt.tight_layout()\nplt.savefig(\"poker_convergence.png\", dpi=300)\nplt.show()\n\n# ---- B. 13x13 starting-hand equity heatmap -------------------------------\n# Rows/columns are high-to-low rank. Diagonal=pairs, upper triangle=suited,\n# lower triangle=offsuit. Each class is represented by a valid specific combo.\nprint(\"Running starting-hand heatmap...\")\nrank_order = list(reversed(RANKS))\nheatmap = np.zeros((13, 13), dtype=float)\n\nfor row, r1 in enumerate(rank_order):\n    for col, r2 in enumerate(rank_order):\n        if row == col:                 # pair\n            hero = f\"{r1}s {r2}h\"\n        elif row < col:                 # suited upper triangle\n            hero = f\"{r1}s {r2}s\"\n        else:                           # offsuit lower triangle\n            hero = f\"{r1}s {r2}h\"\n        res = calculate_equity(hero, \"\", num_simulations=HEATMAP_N,\n                               seed=ANALYTICS_SEED + row * 13 + col)\n        heatmap[row, col] = equity_from_result(res)\n\nfig, ax = plt.subplots(figsize=(11, 9))\nim = ax.imshow(heatmap, cmap=\"RdYlGn\", vmin=0, vmax=1)\nax.set_xticks(range(13), labels=rank_order)\nax.set_yticks(range(13), labels=rank_order)\nax.set_xlabel(\"Second card rank\")\nax.set_ylabel(\"First card rank\")\nax.set_title(f\"13\u00d713 Starting-Hand Equity vs Random ({HEATMAP_N:,} sims/class)\")\nfor i in range(13):\n    for j in range(13):\n        ax.text(j, i, f\"{heatmap[i, j]:.2f}\", ha=\"center\", va=\"center\", fontsize=7)\nax.set_xticks(np.arange(-.5, 13, 1), minor=True)\nax.set_yticks(np.arange(-.5, 13, 1), minor=True)\nax.grid(which=\"minor\", color=\"white\", linewidth=1)\nax.tick_params(which=\"minor\", bottom=False, left=False)\nfig.colorbar(im, ax=ax, label=\"Equity (win + half tie)\")\nplt.tight_layout()\nplt.savefig(\"poker_equity_heatmap.png\", dpi=300)\nplt.show()\n\n# ---- C. Normalized post-flop Win/Tie/Loss stacked bars ------------------\n# Representative hand and board progression; each stage is conditional on\n# the cards visible at that stage, and the opponent is random.\nhero_postflop = \"As Ks\"\nboard_progression = {\n    \"Flop\": \"Qh Jh 2c\",\n    \"Turn\": \"Qh Jh 2c 7d\",\n    \"River\": \"Qh Jh 2c 7d 3s\",\n}\npostflop_results = []\nfor stage, board in board_progression.items():\n    result = calculate_equity(hero_postflop, board, num_simulations=POSTFLOP_N,\n                              seed=ANALYTICS_SEED + len(board))\n    postflop_results.append(result)\n    print(f\"{stage}: Win {result['win']:.2f}% | Tie {result['tie']:.2f}% | Loss {result['loss']:.2f}%\")\n\nstages = list(board_progression.keys())\nwins = np.array([r[\"win\"] for r in postflop_results])\nties = np.array([r[\"tie\"] for r in postflop_results])\nlosses = np.array([r[\"loss\"] for r in postflop_results])\n\nfig, ax = plt.subplots(figsize=(8, 5.5))\nx = np.arange(len(stages))\nax.bar(x, wins, label=\"Win\")\nax.bar(x, ties, bottom=wins, label=\"Tie\")\nax.bar(x, losses, bottom=wins + ties, label=\"Loss\")\nax.set_xticks(x, labels=stages)\nax.set_ylim(0, 100)\nax.set_ylabel(\"Probability (%)\")\nax.set_title(f\"{hero_postflop} vs Random: Post-Flop Outcomes\")\nax.legend()\nplt.tight_layout()\nplt.savefig(\"poker_postflop_stacked.png\", dpi=300)\nplt.show()\n\nprint(\"Saved: poker_convergence.png, poker_equity_heatmap.png, poker_postflop_stacked.png\")\n",
