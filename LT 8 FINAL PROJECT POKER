      "source": "# Cell 7: Player, table state & agents\n@dataclass(frozen=True)\nclass TableState:\n    \"\"\"A snapshot of everything an agent is allowed to see when acting.\n\n    Bet and raise sizes are \"raise to\" amounts: the player's total bet on\n    this street after the action, as in standard hold'em.\n    \"\"\"\n\n    street: str\n    betting: str  # \"no-limit\" or \"limit\"\n    board: tuple\n    hole_cards: tuple\n    pot: int\n    to_call: int\n    current_bet: int  # the highest bet on this street so far\n    street_bet: int  # what this player already put in on this street\n    min_raise_to: int  # smallest legal bet/raise\n    max_raise_to: int  # largest legal bet/raise (all-in in no-limit)\n    bets_this_street: int\n    chips: int\n    opponent_chips: int\n    legal_actions: tuple\n    action_history: tuple\n\n    def raise_to_for_pot_fraction(self, fraction):\n        \"\"\"Raise-to amount for a bet worth `fraction` of the pot (counting\n        the call), clamped to the legal range. 1.0 = a pot-sized raise.\"\"\"\n        target = self.current_bet + round(fraction * (self.pot + self.to_call))\n        return max(self.min_raise_to, min(self.max_raise_to, target))\n\n\nclass Player:\n    \"\"\"A seat at the table: chip stack, hole cards and bets this hand.\"\"\"\n\n    def __init__(self, name, chips, agent):\n        self.name = name\n        self.chips = chips\n        self.agent = agent\n        self.reset_for_hand()\n\n    def reset_for_hand(self):\n        self.hole_cards = []\n        self.street_bet = 0  # chips put in on the current street\n        self.total_bet = 0  # chips put in during the whole hand\n        self.folded = False\n\n    def commit(self, amount):\n        \"\"\"Move chips from the stack into the pot (capped at the stack).\"\"\"\n        amount = min(amount, self.chips)\n        self.chips -= amount\n        self.street_bet += amount\n        self.total_bet += amount\n        return amount\n\n    @property\n    def is_all_in(self):\n        return self.chips == 0 and not self.folded\n\n    def __repr__(self):\n        return f\"Player({self.name!r}, chips={self.chips}, agent={self.agent.name})\"\n\n\nclass Agent:\n    \"\"\"Base class: an agent maps a TableState to one of its legal actions.\n\n    `decide` returns \"fold\", \"check\", \"call\", \"all-in\", or a sized bet as\n    (\"bet\", raise_to) / (\"raise\", raise_to). A bare \"bet\" or \"raise\" means\n    the minimum legal size.\n    \"\"\"\n\n    name = \"Agent\"\n    interactive = False  # True for seats controlled by a person\n\n    def decide(self, state):\n        raise NotImplementedError\n\n\nclass PassiveAgent(Agent):\n    \"\"\"Always checks or calls: guarantees the hand reaches showdown.\"\"\"\n\n    name = \"Passive\"\n\n    def decide(self, state):\n        return \"check\" if \"check\" in state.legal_actions else \"call\"\n\n\nclass ScriptedAgent(Agent):\n    \"\"\"Plays a fixed list of actions and remembers every state it saw (tests).\"\"\"\n\n    name = \"Scripted\"\n\n    def __init__(self, actions):\n        self.actions = list(actions)\n        self.seen = []\n\n    def decide(self, state):\n        self.seen.append(state)\n        return self.actions.pop(0)\n\n\nclass RandomAgent(Agent):\n    \"\"\"Dummy agent: picks a legal action at random (weighted) and, in\n    no-limit, a random size from min-raise, 1/2, 3/4 or a full pot.\"\"\"\n\n    name = \"Random\"\n    DEFAULT_WEIGHTS = {\n        \"fold\": 1,\n        \"check\": 4,\n        \"call\": 4,\n        \"bet\": 2,\n        \"raise\": 2,\n        \"all-in\": 0.2,\n    }\n    POT_FRACTIONS = (0.5, 0.75, 1.0)\n\n    def __init__(self, weights=None, rng=None):\n        self.weights = weights or self.DEFAULT_WEIGHTS\n        self.rng = rng or random.Random()\n\n    def decide(self, state):\n        actions = list(state.legal_actions)\n        weights = [self.weights.get(action, 1) for action in actions]\n        action = self.rng.choices(actions, weights=weights, k=1)[0]\n        if action in (\"bet\", \"raise\") and state.betting == \"no-limit\":\n            sizes = [state.min_raise_to] + [\n                state.raise_to_for_pot_fraction(f) for f in self.POT_FRACTIONS\n            ]\n            return action, self.rng.choice(sizes)\n        return action\n\n\nclass HumanAgent(Agent):\n    \"\"\"Interactive seat. The table UI (Cell 12) supplies its actions with\n    buttons; `decide` is a plain-text input() fallback for play_hand().\n    Text commands: f, x, c, a (all-in), or \"b 20\" / \"r 20\" to bet/raise to 20.\n    \"\"\"\n\n    name = \"Human\"\n    interactive = True\n    SHORTCUTS = {\n        \"f\": \"fold\",\n        \"x\": \"check\",\n        \"c\": \"call\",\n        \"b\": \"bet\",\n        \"r\": \"raise\",\n        \"a\": \"all-in\",\n    }\n\n    def decide(self, state):\n        print(f\"\\n--- {state.street} | Board: {format_cards(state.board) or '-'}\")\n        print(\n            f\"Your cards: {format_cards(state.hole_cards)} | Chips: {state.chips}\"\n            f\" | Pot: {state.pot} | To call: {state.to_call}\"\n            f\" | Bet/raise to: {state.min_raise_to}-{state.max_raise_to}\"\n        )\n        options = \"/\".join(state.legal_actions)\n        while True:\n            tokens = input(f\"Action ({options}): \").strip().lower().split()\n            if not tokens:\n                continue\n            choice = self.SHORTCUTS.get(tokens[0], tokens[0])\n            if choice not in state.legal_actions:\n                print(f\"'{choice}' is not legal here. Choose from: {options}\")\n            elif choice in (\"bet\", \"raise\") and len(tokens) > 1:\n                amount = int(tokens[1])\n                if state.min_raise_to <= amount <= state.max_raise_to:\n                    return choice, amount\n                print(f\"Size must be {state.min_raise_to}-{state.max_raise_to}.\")\n            else:\n                return choice"
